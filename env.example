# ─── Telegram ─────────────────────────────────────────────────
BOT_TOKEN=токен_от_BotFather

# Твой Telegram ID (узнать: @userinfobot)
OWNER_ID=123456789

# Произвольная строка-пароль: ею Telegram подписывает запросы к вебхуку.
# Придумай любую (20+ символов, буквы и цифры) и больше нигде не используй.
WEBHOOK_SECRET=придумай_длинную_строку

# Подпись под каждым постом в канале — оставь пустым если не нужна
POST_SIGNATURE=

# ─── Supabase ─────────────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_ключ

# ─── Антиспам ─────────────────────────────────────────────────
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW=3600
